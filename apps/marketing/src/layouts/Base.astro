---
/* Tipografías autoalojadas: ni una petición a fonts.googleapis.com (§8). Las tres
   son OFL, así que se pueden servir desde aquí sin permiso de nadie. */
import "@fontsource/press-start-2p";
import "@fontsource/silkscreen";
import "@fontsource-variable/inter";
import "../styles/global.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { UI, HTML_LANG, LOCALES, type Locale } from "../i18n/ui";

type Props = {
  locale: Locale;
  /** Ruta sin idioma: "" para la portada, "install/" … */
  path: string;
  title?: string | undefined;
  description?: string | undefined;
  /** La obertura solo tiene sentido en la portada. */
  intro?: boolean | undefined;
};

const { locale, path, title, description, intro = false } = Astro.props;
const t = UI[locale];
const pageTitle = title ? `${title} — Distop` : t.meta.title;
const pageDesc = description ?? t.meta.description;
const canonical = new URL(`/${locale}/${path}`, Astro.site);
const socialImage = new URL("/shots/chat.png", Astro.site);
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    {
      LOCALES.map((l) => (
        <link rel="alternate" hreflang={HTML_LANG[l]} href={new URL(`/${l}/${path}`, Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(`/es/${path}`, Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Distop" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1440" />
    <meta property="og:image:height" content="900" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />

    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
        .intro {
          display: none !important;
        }
      </style>
    </noscript>

    <meta name="theme-color" content="#0b0a14" />
    <meta name="color-scheme" content="dark" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' shape-rendering='crispEdges'%3E%3Crect width='12' height='12' fill='%230b0a14'/%3E%3Cpath fill='%235b6cff' d='M2 1h8v1H2zM1 2h1v6H1zM10 2h1v6h-1zM2 8h8v1H2zM3 9h2v1H3zM3 10h1v1H3zM3 4h2v1H3zM6 4h3v1H6z'/%3E%3C/svg%3E"
    />
  </head>

  <body data-intro={intro ? "" : null}>
    <a class="skip-link" href="#content">{t.skip}</a>

    {
      intro && (
        <div class="intro" id="intro" aria-hidden="true">
          <p class="intro__word" id="intro-word">
            {"DISTOP".split("").map((c) => (
              <span>{c}</span>
            ))}
          </p>
          <div class="intro__bar">
            <i id="intro-bar"></i>
          </div>
        </div>
      )
    }

    <Header locale={locale} path={path} />

    <main id="content" class="layout">
      <slot />
    </main>

    <Footer locale={locale} />

    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
