---
import Mark from "./Mark.astro";
import { UI, type Locale } from "../i18n/ui";
import { APP_VERSION, REPO_URL } from "../release.ts";
import { MARKETING } from "../i18n/marketing";

type Props = { locale: Locale };
const { locale } = Astro.props;
const t = UI[locale];
const m = MARKETING[locale];
const L = t.footer.links;

const REPO = REPO_URL;

type Item = { label: string; href: string; icon?: "github" };

const columns: { heading: string; items: Item[] }[] = [
  {
    heading: t.footer.product,
    items: [
      { label: L.features, href: `/${locale}/#features` },
      { label: m.navTutorials, href: `/${locale}/tutorials/` },
      { label: L.install, href: `/${locale}/install/` },
      { label: L.hosting, href: `/${locale}/hosting/` },
    ],
  },
  {
    heading: t.footer.project,
    // Solo lo que existe. Contribuir y Seguridad siguen fuera porque
    // CONTRIBUTING.md y SECURITY.md aun no estan en el repositorio.
    items: [
      { label: L.code, href: REPO, icon: "github" },
      { label: L.license, href: `${REPO}/blob/main/LICENSE` },
    ],
  },
  {
    heading: t.footer.help,
    items: [{ label: L.privacy, href: `/${locale}/privacy/` }],
  },
];
---

<footer class="site-footer layout">
  <div class="site-footer__grid">
    <div>
      <p class="brand" style="margin-block-end:0.75rem">
        <Mark class="brand__mark" />
        Distop
      </p>
      <p class="lead" style="font-size:0.9375rem">{t.footer.tagline}</p>
    </div>

    {
      columns.map((col) => (
        <nav>
          <h2>{col.heading}</h2>
          <ul>
            {col.items.map((item) => (
              <li>
                <a href={item.href} class={item.icon ? "with-icon" : undefined}>
                  {item.icon === "github" && (
                    <svg viewBox="0 0 16 16" aria-hidden="true" class="ico">
                      <path
                        fill="currentColor"
                        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                      />
                    </svg>
                  )}
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="site-footer__legal">
    <p>{t.footer.legal}</p>
    {/* De release.ts, como la descarga. Escrito a mano se quedó en v0.1.0 y
        siguió ahí tres versiones: nadie mira el pie al publicar. */}
    <p class="mono">AGPL-3.0 · v{APP_VERSION}</p>
  </div>
</footer>
