---
import Base from "../../layouts/Base.astro";
import { LOCALES, UI, type Locale } from "../../i18n/ui";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = UI[locale];
const d = t.install.download;

/** El instalador publicado. Se sube a mano en cada versión: la URL cambia. */
const DOWNLOAD_URL = "https://www.mediafire.com/file/s4na7z6ka0estct/Distop_Setup_0.1.0.exe/file";
---

<Base locale={locale} path="install/" title={t.install.title} description={t.install.sub}>
  <section>
    <div class="stack">
      <p class="eyebrow">{t.nav.install}</p>
      <h1>{t.install.title}</h1>
      <p class="lead">{t.install.sub}</p>
    </div>

    <div class="dl reveal">
      <span class="card__tag">{d.tag}</span>
      <h2 class="dl__title">{d.title}</h2>
      <p class="dl__sub">{d.sub}</p>

      <a
        class="btn btn--primary btn--lg"
        href={DOWNLOAD_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="dl__icon" viewBox="0 0 12 12" aria-hidden="true">
          <path d="M5 1h2v4h2v2H7v2H5V7H3V5h2zM2 9h8v2H2z" fill="currentColor" />
        </svg>
        {d.cta}
      </a>

      <p class="dl__host">{d.host}</p>
      <p class="dl__meta">{d.meta}</p>
    </div>

    <div class="stack" style="margin-block-start:2.5rem">
      <h2 class="reveal">{d.stepsTitle}</h2>
      <ol class="steps reveal">
        {
          d.steps.map((step) => (
            <li class="step">
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="notice reveal" style="margin-block-start:2rem">
      <h3>{d.warnTitle}</h3>
      <p>{d.warn}</p>
    </div>

  </section>

  <section style="padding-block-start:0">
    <div class="stack">
      <h2 class="reveal">{t.install.reqTitle}</h2>
      <ul class="reveal list-plain">
        {t.install.reqs.map((r) => <li>{r}</li>)}
      </ul>
    </div>

    {/* Docker, Node y la orden de compose viven aqui dentro: quien solo quiere
        jugar nunca los ve, y quien los busca los encuentra a la primera. */}
    <details class="advanced reveal">
      <summary>{t.install.advancedTitle}</summary>

      <p class="advanced__note">{t.install.advancedNote}</p>

      <div class="grid-cards">
        {
          t.install.ways.map((way) => (
            <article class="card">
              <span class="card__tag">{way.tag}</span>
              <h3>{way.title}</h3>
              <p>{way.body}</p>
              {way.code && (
                <div class="code" style="margin-block-start:0.5rem;box-shadow:none">
                  <pre><code>{way.code}</code></pre>
                </div>
              )}
            </article>
          ))
        }
      </div>

      <div class="code" style="margin-block-start:1.25rem">
        <div class="code__bar">
          <span class="code__dot" aria-hidden="true"></span>
          {t.host.codeLabel}
        </div>
        <pre><code>{t.host.code}</code></pre>
      </div>
    </details>
  </section>

</Base>
