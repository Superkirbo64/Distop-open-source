{
  "name": "@distop/mobile",
  "version": "0.1.7",
  "private": true,
  "description": "Cliente Android de Distop: el mismo cliente web, empaquetado con Capacitor.",
  "scripts": {
    "sync": "npm run build --workspace @distop/web --prefix ../.. && npm run stage-server && cap sync android",
    "stage-server": "node ../../scripts/stage-server.mjs --mobile ../web/dist/nodejs",
    "open": "cap open android",
    "assets": "capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "capacitor-nodejs": "https://github.com/hampoelz/Capacitor-NodeJS/releases/download/v1.0.0-beta.9/capacitor-nodejs.tgz",
    "node-sqlite3-wasm": "^0.8.60"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.0"
  }
}
