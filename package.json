{
  "name": "distop",
  "version": "0.1.6",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace @distop/node-server",
    "dev:web": "npm run dev --workspace @distop/web",
    "build": "npm run build --workspace @distop/web",
    "start": "npm run start --workspace @distop/node-server",
    "host": "node scripts/host.mjs",
    "shot": "node scripts/shot.mjs",
    "voice-check": "node scripts/voice-check.mjs",
    "site": "npm run dev --workspace @distop/marketing",
    "site:build": "npm run build --workspace @distop/marketing",
    "test": "npm run test --workspace @distop/node-server && npm run test --workspace @distop/web && npm run test --workspace @distop/desktop",
    "typecheck": "tsc -p apps/node-server --noEmit && tsc -p apps/web --noEmit && npm run typecheck --workspace @distop/desktop && npm run typecheck --workspace @distop/marketing"
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "typescript": "5.7.3"
  }
}
