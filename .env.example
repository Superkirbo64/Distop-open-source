# ─── Instancia self-hosted (apps/node-server) ────────────────────────────────
# Copia este archivo a .env y ajústalo. Nunca subas el .env real (§33).

PORT=5000
HOST=0.0.0.0
INSTANCE_NAME=Mi instancia Distop

# URL pública por la que llega la gente (dominio propio o túnel).
PUBLIC_URL=

# ─── Datos ───────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/app.db
DEFAULT_STORAGE_PATH=./data/uploads

# ─── Seguridad ───────────────────────────────────────────────────────────────
# OBLIGATORIO en producción. Genera uno con:  openssl rand -hex 32
# Sin él, en desarrollo se usa uno efímero y cada reinicio cierra las sesiones.
AUTH_SECRET=

# Código para reclamar una instancia recién instalada DESDE OTRO EQUIPO.
# Si la abres en el mismo ordenador que la hospeda no se pide nada. Déjalo vacío
# y se genera uno solo, impreso en el terminal al arrancar.
SETUP_CODE=

ACCESS_TOKEN_TTL_S=3600
REFRESH_TOKEN_TTL_S=2592000

# Orígenes del cliente web separados por coma. En producción, tu dominio real.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ponlo en true SOLO si hay un proxy o túnel delante (Cloudflare Tunnel, Nginx,
# Traefik…). Activado sin proxy, cualquiera falsea X-Forwarded-For y salta los
# límites. Desactivado detrás de un túnel, toda tu comunidad comparte una IP y
# el límite de altas la deja fuera a partir de cierto punto.
TRUST_PROXY=false

# Límites por IP. Suben si tu comunidad entra en bloque desde una misma red
# (una casa, una oficina, un campus) y se queda sin altas.
MAX_REGISTRATIONS_PER_HOUR=30
MAX_GUESTS_PER_HOUR=60
MAX_LOGIN_ATTEMPTS_PER_15MIN=20

# ─── Políticas de la instancia ───────────────────────────────────────────────
REGISTRATION_ENABLED=true
GUEST_MODE_ENABLED=true
PUBLIC_DISCOVERY_ENABLED=false

# ─── Archivos ────────────────────────────────────────────────────────────────
# El límite depende de tu disco y tu ancho de banda, no de ningún plan (§28.3).
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_TYPES=image/png,image/jpeg,image/gif,image/webp,video/mp4,video/webm,audio/mpeg,audio/ogg,application/pdf,text/plain,application/zip

LOG_LEVEL=info

# ─── Cliente web en desarrollo (apps/web) ────────────────────────────────────
# A qué instancia apunta el proxy de Vite.
NODE_SERVER_URL=http://localhost:5000
