# ─── Instancia self-hosted (apps/node-server) ────────────────────────────────
# Copia este archivo a .env y ajústalo. Nunca subas el .env real (§33).

PORT=5000
HOST=0.0.0.0
INSTANCE_NAME=Mi instancia Distop

# URL pública por la que llega la gente (dominio propio o túnel).
PUBLIC_URL=

# Web Push (A2): con quien se queja el servicio de push del navegador si algo
# va mal (RFC 8292, campo `sub`). Vacio = la direccion publica de arriba, que
# ya conoce quien se suscribio. Un mailto: sirve si prefieres que te escriban.
# Las claves VAPID las genera la instancia sola en data/push.key; no se ponen
# aqui y no hay que registrarse en ningun sitio.
PUSH_CONTACT=

# ─── Datos ───────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/app.db
DEFAULT_STORAGE_PATH=./data/uploads

# ─── Seguridad ───────────────────────────────────────────────────────────────
# Déjalo vacío y la instancia se crea el suyo en data/secret.key, con permisos
# de solo-dueño, la primera vez que arranca. No hace falta tocar nada.
# Rellénalo solo si tu despliegue inyecta secretos por entorno (Docker, CI): esa
# vía manda sobre el fichero. Escribirlo aquí a mano deja el secreto en un
# fichero que se abre, se comparte en capturas y se sube por error.
AUTH_SECRET=

# Código para reclamar una instancia recién instalada DESDE OTRO EQUIPO.
# Si la abres en el mismo ordenador que la hospeda no se pide nada. Déjalo vacío
# y se genera uno solo, impreso en el terminal al arrancar.
SETUP_CODE=

ACCESS_TOKEN_TTL_S=3600
REFRESH_TOKEN_TTL_S=2592000

# Orígenes del cliente web separados por coma. En producción, tu dominio real.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ponlo en true SOLO si hay un proxy o túnel delante (Cloudflare Tunnel, Nginx,
# Traefik…). Activado sin proxy, cualquiera falsea X-Forwarded-For y salta los
# límites. Desactivado detrás de un túnel, toda tu comunidad comparte una IP y
# el límite de altas la deja fuera a partir de cierto punto.
TRUST_PROXY=false

# Límites por IP. Suben si tu comunidad entra en bloque desde una misma red
# (una casa, una oficina, un campus) y se queda sin altas.
MAX_REGISTRATIONS_PER_HOUR=30
MAX_GUESTS_PER_HOUR=60
MAX_LOGIN_ATTEMPTS_PER_15MIN=20

# ─── Políticas de la instancia ───────────────────────────────────────────────
REGISTRATION_ENABLED=true
GUEST_MODE_ENABLED=true
PUBLIC_DISCOVERY_ENABLED=false
# Servicio índice que alimenta Explorar. Vacío = solo se muestran las
# comunidades públicas de esta misma instancia. La URL oficial se añadirá
# cuando se publique apps/directory en Deno Deploy.
DIRECTORY_URL=

# ─── Archivos ────────────────────────────────────────────────────────────────
# El límite depende de tu disco y tu ancho de banda, no de ningún plan (§28.3).
# Si publicas la instancia con Cloudflare Tunnel, Cloudflare recorta las
# subidas a ~100 MB en su borde antes de que este número entre en juego: subirlo
# no cambia ese techo para quien entra por el túnel. Accediendo en directo (LAN,
# tu propio dominio sin Cloudflare por delante) sí vale el límite de aquí.
MAX_UPLOAD_SIZE_MB=500
# Déjalo sin poner para aceptar lo de fábrica (imágenes, vídeo, audio, PDF,
# texto, comprimidos y programas). Ponlo solo si quieres una lista MÁS cerrada.
# Ojo con .zip y .exe: el navegador les da un tipo distinto según el sistema
# (application/zip vs application/x-zip-compressed; un .exe suele llegar como
# application/octet-stream), así que una lista a mano tiene que incluir las
# variantes o el mismo archivo se acepta en Linux y se rechaza en Windows.
# ALLOWED_UPLOAD_TYPES=image/png,image/jpeg,application/pdf

# ─── Buscador de GIF ─────────────────────────────────────────────────────────
# Opcional y apagado si se deja vacío: sin clave, la pestaña de GIF no aparece.
# La clave gratuita se pide en https://developers.giphy.com
#
# La búsqueda la hace ESTA instancia, no el navegador de cada miembro: así Giphy
# solo ve esta máquina, y ni las IP ni los términos de búsqueda de la comunidad
# salen de aquí. Al enviar un GIF se guarda como adjunto en el disco del
# anfitrión en vez de enlazarlo, para que el mensaje no dependa de un tercero.
GIPHY_API_KEY=

# Galería de stickers (opcional). Servicio aparte del de GIF: puedes poner uno,
# el otro, los dos o ninguno.
#
# La clave gratuita se pide en https://klipy.com/developers — la de prueba
# admite 100 llamadas por hora. Se eligió Klipy porque está pensado para
# stickers y devuelve WebP y PNG con transparencia, que es lo que diferencia
# un sticker de un GIF cuadrado con fondo.
#
# Igual que Giphy: la búsqueda la hace ESTA instancia, no el navegador. Sin
# clave la galería no aparece y los stickers propios de cada comunidad siguen
# funcionando exactamente igual.
KLIPY_API_KEY=

# Fondos de pantalla (opcional, y opcional de verdad: por defecto funciona).
# El buscador usa la API de Wallhaven, que sin clave da 45 peticiones/minuto y
# ya devuelve todo lo SFW —que es lo único que esta instancia pide. La clave
# solo desbloquea contenido NSFW, así que dejarla vacía no quita nada.
WALLHAVEN_API_KEY=

# Importar stickers desde un paquete de Telegram como sticker propio de la
# comunidad (opcional: sin token, la opción de importar no aparece).
# El token es de un BOT, no de una cuenta personal: se saca hablándole a
# @BotFather en Telegram, gratis y en segundos.
TELEGRAM_BOT_TOKEN=

# ─── Voz y vídeo ─────────────────────────────────────────────────────────────
# Sin esto, la voz y la cámara SOLO funcionan entre equipos de la misma red: sin
# STUN cada navegador únicamente conoce su IP privada y no sabe qué dirección
# ofrecerle al otro. Es un servicio diminuto (un par de paquetes al conectar),
# no retransmite audio ni vídeo, así que no consume ancho de banda de nadie.
#
# En redes cerradas (NAT simétrica, muchas conexiones móviles) el STUN no basta
# y hace falta TURN, que SÍ retransmite el audio y el vídeo y por tanto consume
# ancho de banda de quien lo hospede. Solo entra en juego cuando no hay camino
# directo; mientras lo haya, la llamada sigue yendo de navegador a navegador.
#
# NORMALMENTE NO HACE FALTA TOCAR ESTO. La instancia ya trae STUN, y el TURN se
# pone desde la aplicación en Ajustes → Voz y vídeo, donde además hay un botón
# que comprueba si responde de verdad. Rellenar esta variable BLOQUEA ese ajuste:
# lo que pongas aquí manda y desde la interfaz no se puede cambiar.
#
# Con TURN propio (coturn en tu servidor):
#   ICE_SERVERS=stun:stun.cloudflare.com:3478,turn:usuario:clave@turn.tudominio.org:3478
#
# Lo más cómodo es el relevo de Cloudflare Realtime (1 TB al mes gratis), que se
# configura desde la aplicación pegando el TURN Key ID y su token: la instancia
# pide credenciales cortas en tu nombre y la clave nunca sale de aquí.
#
# No hay ningún TURN público y sin cuenta que funcione: los que circulan por los
# tutoriales (openrelay entre ellos) están caídos o ya piden registrarse. Apuntar
# uno muerto es peor que no poner ninguno, porque la llamada falla igual pero
# parece configurada.
# ICE_SERVERS=

# Coturn propio con credenciales que caducan solas (use-auth-secret). Pensado
# para un despliegue con coturn propio (docs/nube-vps.md): genera el secreto
# y se lo da a coturn y a la instancia a la vez. Van los dos juntos o ninguno —
# el arranque muere si falta uno. El secreto jamás viaja al navegador: cada
# visita recibe un usuario "caducidad:distop" y una contraseña HMAC válidos 24 h.
# Con esto puesto, el panel de Voz y vídeo aparece bloqueado, igual que con
# ICE_SERVERS: rotar el secreto de coturn desde la interfaz no es posible, y
# desincronizarlos en silencio sería peor. Necesita el reloj de la máquina en
# hora (NTP): coturn rechaza credenciales con caducidad absurda.
#   TURN_URL=turn:comunidad.example.org:3478?transport=udp,turn:comunidad.example.org:3478?transport=tcp
#   TURN_SECRET=el-mismo-static-auth-secret-que-tiene-coturn
# TURN_URL=
# TURN_SECRET=

# ─── Copias programadas (docs/nube-oracle.md) ────────────────────────────────
# Apagadas de fábrica (0). Existen porque detrás de un proxy con TRUST_PROXY y
# PUBLIC_URL ninguna petición es "local" y la ruta HTTP de crear copias queda
# fuera de alcance a propósito: sin esto, un despliegue en nube no tendría copia
# diaria. La frase va en un FICHERO con permisos 0600, nunca aquí (un .env se
# abre, se comparte en capturas y se sube por error). Guárdalo dentro del
# volumen de datos: si el contenedor se recrea sin él, el arranque muere — a
# propósito, mejor que descubrir copias apagadas el día que muere el disco.
# El contenido del fichero, quitando solo el salto de línea final, es byte a
# byte lo que irá en DISTOP_BACKUP_PASSPHRASE al restaurar (restore.ts). No
# guardes la frase junto a las copias, y saca una copia fuera de la máquina.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_PASSPHRASE_FILE=./data/backup-passphrase
# BACKUP_KEEP=7

LOG_LEVEL=info

# ─── Cliente web en desarrollo (apps/web) ────────────────────────────────────
# A qué instancia apunta el proxy de Vite.
NODE_SERVER_URL=http://localhost:5000
