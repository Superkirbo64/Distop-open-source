# bytecode de los scripts sueltos de Python que se usan de andamio y se tiran
__pycache__/
*.pyc

# app de escritorio: artefactos de electron-builder y protocolo transpilado
apps/desktop/release/
apps/desktop/release-*/
apps/desktop/staging/
# y el zip que se sube a mano: GitHub rechaza archivos de mas de 100 MB
apps/desktop/release.zip

# android: nunca el keystore, ni los APK compilados
*.keystore
keystore.properties
apps/mobile/release/

# ajustes locales de Claude Code: llevan rutas y usuario de esta maquina
.claude/settings.local.json

# Instaladores locales (Electron + Tauri) copiados por conveniencia
/release/
apps/desktop-tauri/src-tauri/target/

# Claves que la instancia se genera sola al arrancar: la identidad del nodo
# (instance.key) y el secreto de sesiones (secret.key). No son de ejemplo,
# son las de verdad de esa instalación, y hasta ahora nada impedía subirlas:
# *.keystore no cubre *.key, aunque lo parezca al leerlo por encima.
*.key
